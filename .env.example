# Copy to .env for local development and replace every value.
# Never commit the real .env file.

API_TOKEN=replace-with-a-long-random-token
CORS_ORIGIN=
RATE_LIMIT_MAX=60
RATE_LIMIT_MAX_CLIENTS=10000

POSTGRES_DB=blockchain_transactions
POSTGRES_USER=transaction_service
POSTGRES_PASSWORD=replace-with-a-long-random-password

DATABASE_URL=postgresql://transaction_service:replace-with-a-long-random-password@postgres:5432/blockchain_transactions
DB_SSL=false

RPC_URL=
API_KEY=
