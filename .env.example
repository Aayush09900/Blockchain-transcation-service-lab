# Copy to .env for local development only.
# Never commit .env or real credentials.

NODE_ENV=development
PORT=3000
API_TOKEN=replace-with-a-long-random-token
CORS_ORIGIN=
RATE_LIMIT_MAX=60
RATE_LIMIT_MAX_CLIENTS=10000

# MySQL: source of truth for transaction state and outbox
MYSQL_URL=mysql://transaction_service:replace-password@127.0.0.1:3306/blockchain_transactions
MYSQL_SSL=false
MYSQL_POOL_MAX=10

# MongoDB: audit/event read model
MONGO_URL=mongodb://audit_user:replace-password@127.0.0.1:27017/?authSource=admin
MONGO_DATABASE=blockchain_transaction_audit
MONGO_MAX_POOL_SIZE=20

# Outbox publisher
OUTBOX_POLL_MS=1000

# Ethers / blockchain anchor
BLOCKCHAIN_ENABLED=false
CHAIN_RPC_URL=
CHAIN_ID=
CHAIN_SIGNER_PRIVATE_KEY=
ANCHOR_CONTRACT_ADDRESS=
